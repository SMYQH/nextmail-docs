{
  "name": "nextmail-docs",
  "version": "0.1.0",
  "private": true,
  "description": "NextMail documentation site (Docusaurus)",
  "scripts": {
    "docusaurus": "node --import ./scripts/deploy-env.mjs ./node_modules/@docusaurus/core/bin/docusaurus.mjs",
    "start": "node --import ./scripts/deploy-env.mjs ./node_modules/@docusaurus/core/bin/docusaurus.mjs start",
    "build": "node --import ./scripts/deploy-env.mjs ./node_modules/@docusaurus/core/bin/docusaurus.mjs build",
    "serve": "node --import ./scripts/deploy-env.mjs ./node_modules/@docusaurus/core/bin/docusaurus.mjs serve",
    "clear": "node --import ./scripts/deploy-env.mjs ./node_modules/@docusaurus/core/bin/docusaurus.mjs clear",
    "swizzle": "node --import ./scripts/deploy-env.mjs ./node_modules/@docusaurus/core/bin/docusaurus.mjs swizzle",
    "write-translations": "node --import ./scripts/deploy-env.mjs ./node_modules/@docusaurus/core/bin/docusaurus.mjs write-translations",
    "typecheck": "tsc",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "config:env": "node scripts/init-deploy-env.mjs",
    "tokens:generate": "node scripts/generate-fluent-tokens.mjs",
    "prestart": "npm run tokens:generate",
    "prebuild": "npm run tokens:generate"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@fluentui/react-components": "^9.75.1",
    "@fluentui/react-icons": "^2.0.345",
    "@fluentui/react-theme": "^9.2.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@docusaurus/types": "3.10.2",
    "typescript": "~5.9.3",
    "wrangler": "^4.149.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.12"
  }
}
